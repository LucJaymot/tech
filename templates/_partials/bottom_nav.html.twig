{% set current_route = app.request.attributes.get('_route') %}
{% set items = [
    {route: 'app_home', label: 'Accueil', icon: 'M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75'},
    {route: 'app_about', label: 'À propos', icon: 'M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z'},
] %}
{% if is_granted('ROLE_USER') %}
    {% set items = items|merge([
        {route: 'app_collective', label: 'Collectif', icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z'},
    ]) %}
{% else %}
    {% set items = items|merge([
        {route: 'app_login', label: 'Connexion', icon: 'M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75'},
    ]) %}
{% endif %}
<nav aria-label="Navigation principale" class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-800 bg-slate-900/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
    <ul class="mx-auto flex max-w-2xl">
        {% for item in items %}
            {% set active = current_route == item.route %}
            <li class="flex-1">
                <a href="{{ path(item.route) }}"
                   {% if active %}aria-current="page"{% endif %}
                   class="flex min-h-16 flex-col items-center justify-center gap-1 text-xs font-medium transition-colors {{ active ? 'text-indigo-400' : 'text-slate-400 hover:text-slate-200' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
                    </svg>
                    {{ item.label }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
