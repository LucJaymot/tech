{# Top-level screens only. A tab stays lit on the pages below it: "sections" are route name prefixes. #}
{% set current_route = app.request.attributes.get('_route') ?? '' %}
{% if is_granted('ROLE_USER') %}
    {% set items = [
        {route: 'app_home', label: 'Accueil', sections: ['app_home'], icon: 'M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75'},
        {route: 'app_soirees', label: 'Soirées', sections: ['app_soiree', 'app_planning', 'app_retroplanning', 'app_feuille_de_route', 'app_guest_list', 'app_pointage', 'app_budget', 'app_bilan', 'app_visuels', 'app_line_up'], icon: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5'},
        {route: 'app_collective', label: 'Collectif', sections: ['app_collective', 'app_invitation'], icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z'},
    ] %}
{% else %}
    {% set items = [
        {route: 'app_home', label: 'Accueil', sections: ['app_home'], icon: 'M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75'},
        {route: 'app_login', label: 'Connexion', sections: ['app_login'], icon: 'M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75'},
    ] %}
{% endif %}
<nav aria-label="Navigation principale" class="fixed inset-x-0 bottom-0 z-40 border-t border-slate-800 bg-barre/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
    <ul class="mx-auto flex max-w-2xl">
        {% for item in items %}
            {% set active = item.sections|filter(prefixe => current_route starts with prefixe)|length > 0 %}
            <li class="flex-1">
                <a href="{{ path(item.route) }}"
                   {% if active %}aria-current="page"{% endif %}
                   class="flex min-h-16 flex-col items-center justify-center gap-1.5 font-mono text-[0.6875rem] tracking-[0.12em] uppercase transition-colors {{ active ? 'text-slate-100' : 'text-slate-400 hover:text-slate-200' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="size-6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
                    </svg>
                    {{ item.label }}
                </a>
            </li>
        {% endfor %}
    </ul>
</nav>
