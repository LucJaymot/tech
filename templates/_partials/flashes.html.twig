{# A neutral surface and a LED of the status colour, as on the charter. #}
{% set leds = {
    success: 'bg-emerald-400 shadow-[0_0_10px_rgb(52_199_89/0.7)]',
    error: 'bg-red-500 shadow-[0_0_10px_rgb(255_59_48/0.8)]',
    warning: 'bg-amber-400 shadow-[0_0_10px_rgb(255_176_0/0.7)]',
    info: 'bg-slate-400',
} %}
{% set flashes = app.flashes %}
{% if flashes is not empty %}
<div class="mb-6 flex flex-col gap-2">
    {% for type, messages in flashes %}
        {% for message in messages %}
            <div data-controller="flash"
                 role="{{ type == 'error' ? 'alert' : 'status' }}"
                 class="flex items-start gap-3 rounded-lg border border-slate-800 bg-slate-900 px-4 py-3 text-sm text-slate-100 shadow-lg transition-opacity duration-300">
                <span class="mt-1.5 h-1.5 w-6 shrink-0 rounded-[2px] {{ leds[type] ?? leds.info }}" aria-hidden="true"></span>
                <p class="flex-1">{{ message|trans }}</p>
                <button type="button" data-action="flash#close" class="-m-2 p-2 opacity-70 hover:opacity-100" aria-label="Fermer">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}
