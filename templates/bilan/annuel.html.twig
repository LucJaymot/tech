{% extends 'base.html.twig' %}

{% block title %}Bilan {{ annee }}{% endblock %}

{% block body %}
    {{ include('_partials/retour_soiree.html.twig', {href: path('app_soirees'), nom: 'Soirées'}) }}
    <p class="etiquette">Bilan annuel · année civile</p>
    <h1 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">{{ annee }}</h1>
    <p class="mt-2 flex gap-4 text-sm">
        <a href="{{ path('app_bilan_annuel', {annee: annee - 1}) }}" class="text-indigo-400 underline">{{ annee - 1 }}</a>
        <a href="{{ path('app_bilan_annuel', {annee: annee + 1}) }}" class="text-indigo-400 underline">{{ annee + 1 }}</a>
    </p>

    {% set t = bilan.total %}
    <div class="mt-6 flex flex-col gap-4">
        <twig:Card title="Soirées" description="Charges estimées comprises, comme sur chaque budget.">
            {% if bilan.soirees is empty %}
                <p class="text-slate-500">Aucune soirée cette année.</p>
            {% else %}
                <div class="-mx-4 overflow-x-auto px-4">
                    <table class="w-full min-w-[32rem] text-sm" id="bilan-annuel">
                        <thead class="text-xs text-slate-400">
                            <tr><th class="pb-2 text-left font-normal">Soirée</th><th class="pb-2 text-right font-normal">Dépenses prév. / réelles</th><th class="pb-2 text-right font-normal">Recettes prév. / réelles</th><th class="pb-2 text-right font-normal">Solde prév. / réel</th></tr>
                        </thead>
                        <tbody>
                            {% for s in bilan.soirees %}
                                <tr class="border-t border-slate-800">
                                    <th scope="row" class="py-2 pr-3 text-left font-normal"><a href="{{ path('app_bilan', {id: s.id}) }}" class="underline">{{ s.nom }}</a><br><span class="text-xs text-slate-400">{{ s.date|date('d/m/Y') }}{% if s.sans_reel %} · {{ s.sans_reel }} réel{{ s.sans_reel > 1 ? 's' }} manquant{{ s.sans_reel > 1 ? 's' }}{% endif %}</span></th>
                                    <td class="py-2 pr-3 text-right font-mono tabular-nums">{{ s.totaux.depensesPrevues|euros }}<br>{{ s.totaux.depensesReelles|euros }}</td>
                                    <td class="py-2 pr-3 text-right font-mono tabular-nums">{{ s.totaux.recettesPrevues|euros }}<br>{{ s.totaux.recettesReelles|euros }}</td>
                                    <td class="py-2 text-right font-mono tabular-nums">{{ s.totaux.soldePrevu|euros }}<br>{{ s.totaux.soldeReel|euros }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot class="font-semibold">
                            <tr class="border-t border-slate-700">
                                <th scope="row" class="py-2 pr-3 text-left">Total</th>
                                <td class="py-2 pr-3 text-right font-mono tabular-nums">{{ t.depenses_prevues|euros }}<br>{{ t.depenses_reelles|euros }}</td>
                                <td class="py-2 pr-3 text-right font-mono tabular-nums">{{ t.recettes_prevues|euros }}<br>{{ t.recettes_reelles|euros }}</td>
                                <td class="py-2 text-right font-mono tabular-nums">{{ t.solde_prevu|euros }}<br>{{ t.solde_reel|euros }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            {% endif %}
            <twig:block name="footer">
                <twig:Button href="{{ path('app_bilan_annuel_csv', {annee: annee}) }}" variant="secondary" size="sm" data-turbo="false">Exporter en CSV</twig:Button>
            </twig:block>
        </twig:Card>
    </div>
{% endblock %}
