{% extends 'base.html.twig' %}

{% block title %}Budget · {{ soiree.nom }}{% endblock %}

{% block body %}
    {{ include('_partials/retour_soiree.html.twig', {id: soiree.id, nom: soiree.nom}) }}
    <p class="etiquette">Budget · {{ soiree.date|date('d/m/Y') }}</p>
    <h1 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">{{ soiree.nom }}</h1>

    <twig:Budget :soiree="soiree" class="mt-6" />
{% endblock %}
