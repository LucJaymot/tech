{% extends 'base.html.twig' %}

{% block title %}{{ collective ? collective.name : 'Collectif' }}{% endblock %}

{% block body %}
    {% if collective is null %}
        <twig:EmptyState title="Aucun collectif" description="Vous n'êtes membre d'aucun collectif pour le moment." />
    {% else %}
        <p class="etiquette">Collectif actif</p>
        <h1 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">{{ collective.name }}</h1>

        <div class="mt-8 flex flex-col gap-6">
            <twig:Card title="Membres" description="{{ memberships|length }} membre{{ memberships|length > 1 ? 's' }}">
                <ul class="-my-2 divide-y divide-slate-800" id="membres">
                    {% for membership in memberships %}
                        <li class="flex items-center justify-between gap-3 py-3">
                            <div class="min-w-0">
                                <p class="truncate font-medium">{{ membership.user.displayName }}</p>
                                <p class="truncate text-sm text-slate-400">{{ membership.user.email }}</p>
                            </div>
                            <twig:Badge status="{{ {admin: 'info', member: 'success', reader: 'neutral'}[membership.role.value] }}" :dot="false">
                                {{ membership.role.label }}
                            </twig:Badge>
                        </li>
                    {% endfor %}
                </ul>
                <twig:block name="footer">
                    {% if can_manage %}
                        <twig:Button href="{{ path('app_invitation_new') }}" size="sm">Inviter un membre</twig:Button>
                    {% endif %}
                </twig:block>
            </twig:Card>


            {% if can_manage and invitations is not empty %}
                <twig:Card title="Invitations en attente">
                    <ul class="-my-2 divide-y divide-slate-800" id="invitations">
                        {% for invitation in invitations %}
                            <li class="flex items-center justify-between gap-3 py-3">
                                <div class="min-w-0">
                                    <p class="truncate font-medium">{{ invitation.email }}</p>
                                    <p class="text-sm text-slate-400">{{ invitation.role.label }} · expire le {{ invitation.expiresAt|date('d/m', 'Europe/Paris') }}</p>
                                </div>
                                <form method="post" action="{{ path('app_invitation_cancel', {id: invitation.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel-invitation') }}">
                                    <twig:Button type="submit" variant="ghost" size="sm" aria-label="Annuler l'invitation de {{ invitation.email }}">Annuler</twig:Button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                </twig:Card>
            {% endif %}

            <twig:Card title="Notifications" description="Rappels des démarches sur ce téléphone ou cet ordinateur, en plus des e-mails." id="notifications">
                <div class="flex flex-wrap items-center justify-between gap-3"
                     data-controller="notifications"
                     data-notifications-cle-value="{{ cle_push }}"
                     data-notifications-abonner-value="{{ path('app_push_abonner') }}"
                     data-notifications-desabonner-value="{{ path('app_push_desabonner') }}"
                     data-notifications-jeton-value="{{ csrf_token('push') }}">
                    <p class="text-sm text-slate-300" data-notifications-target="etat" aria-live="polite">Vérification…</p>
                    <twig:Button size="sm" variant="secondary" data-notifications-target="bouton" data-action="notifications#basculer" hidden>Activer</twig:Button>
                </div>
            </twig:Card>

            {% if can_manage %}
                <twig:Card title="Identité visuelle" description="Couleur, typo des titres et logo : dans l'app, sur les pages publiques et les visuels de line-up." id="identite">
                    <form method="post" action="{{ path('app_collective_identite') }}" enctype="multipart/form-data" data-turbo="false" class="flex flex-col gap-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('identite') }}">
                        <label class="flex items-center gap-3 text-sm">
                            <input type="color" name="couleur" value="{{ collective.couleurAccent }}" list="accents-charte" class="h-11 w-14 rounded border border-slate-700 bg-slate-900">
                            <datalist id="accents-charte"><option value="#6e8bff"></option><option value="#c77dff"></option><option value="#2ee6d6"></option><option value="#ff5fa2"></option></datalist>
                            Couleur d'accent
                        </label>
                        <label class="flex flex-col gap-1 text-sm">
                            Typo des titres
                            <select name="style_titres" class="rounded border border-slate-700 bg-slate-900 px-3 py-2.5 text-slate-100">
                                {% for style in styles_titres %}
                                    <option value="{{ style.value }}" {{ style == collective.styleTitres ? 'selected' }} style="font-family: {{ style.police }}">{{ style.label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <div class="flex items-center gap-4">
                            {% set logo = logo_collectif() %}
                            {% if logo %}<img src="{{ logo }}" alt="Logo actuel" width="64" height="64" class="size-16 shrink-0 rounded-md border border-slate-800 object-contain" id="logo-actuel">{% endif %}
                            <div class="flex flex-col gap-2">
                                <label class="flex flex-col gap-1 text-sm">
                                    {{ logo ? 'Remplacer le logo' : 'Logo' }} (PNG ou JPEG, 1 Mo au plus)
                                    <input type="file" name="logo" accept="image/png,image/jpeg" class="text-slate-300">
                                </label>
                                {% if logo %}
                                    <label class="flex min-h-11 items-center gap-2 text-sm text-slate-300"><input type="checkbox" name="retirer_logo" value="1" class="size-5"> Retirer le logo</label>
                                {% endif %}
                            </div>
                        </div>
                        <div><twig:Button type="submit" size="sm">Enregistrer</twig:Button></div>
                    </form>
                </twig:Card>
            {% endif %}

        </div>
    {% endif %}

    <form method="post" action="{{ path('app_logout') }}" class="mt-8">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" data-controller="csrf-protection">
        <twig:Button type="submit" variant="ghost" block>Se déconnecter</twig:Button>
    </form>
{% endblock %}
