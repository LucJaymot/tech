<header {{ attributes.defaults({class: 'sticky top-0 z-30 border-b border-slate-800 bg-slate-950/95 pt-[env(safe-area-inset-top)] backdrop-blur'}) }}>
    <div class="mx-auto flex min-h-14 max-w-2xl items-center gap-2 px-4 sm:px-6">
        {% set active = this.active %}
        {% set choices = active ? this.choices : [] %}
        {% if active is null %}
            <p class="text-sm text-slate-400">Aucun collectif</p>
        {% elseif choices|length > 1 %}
            <form method="post" action="{{ path('app_collective_switch') }}" data-controller="auto-submit" class="flex min-w-0 flex-1 items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('switch-collective') }}">
                <input type="hidden" name="_target_path" value="{{ app.request.pathInfo }}">
                <label for="collective-switcher" class="sr-only">Collectif actif</label>
                <select id="collective-switcher" name="collective" data-action="auto-submit#submit"
                        class="min-w-0 flex-1 truncate rounded-lg border border-slate-700 bg-slate-900 py-2 pr-8 pl-3 text-base font-semibold text-slate-100 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    {% for choice in choices %}
                        <option value="{{ choice.id }}" {{ choice.id == active.id ? 'selected' }}>{{ choice.name }} · {{ choice.role.label }}</option>
                    {% endfor %}
                </select>
                {# Hidden once JavaScript submits on change. #}
                <twig:Button type="submit" variant="secondary" size="sm" data-auto-submit-target="button">Changer</twig:Button>
            </form>
        {% else %}
            <p class="min-w-0 flex-1 truncate font-semibold">{{ active.name }}</p>
        {% endif %}
    </div>
</header>
