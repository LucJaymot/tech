{#
    État vide, avec icône et actions optionnelles.
    <twig:EmptyState title="Aucune réservation" description="Elles apparaîtront ici.">
        <twig:Button href="#">Réserver</twig:Button>
    </twig:EmptyState>
    Bloc « icon » pour remplacer l'icône par défaut.
#}
{% props title, description = null %}
<div {{ attributes.defaults({class: 'flex flex-col items-center rounded-xl border border-dashed border-slate-700 px-6 py-10 text-center'}) }}>
    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-slate-800 text-slate-400" aria-hidden="true">
        {% block icon %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H6.911a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661z"/>
            </svg>
        {% endblock %}
    </div>
    <h3 class="text-base font-semibold text-slate-100">{{ title }}</h3>
    {% if description %}<p class="mt-1 max-w-sm text-sm text-slate-400">{{ description }}</p>{% endif %}
    {% if block('content')|trim is not empty %}
        <div class="mt-6 flex flex-wrap justify-center gap-2">{% block content %}{% endblock %}</div>
    {% endif %}
</div>
