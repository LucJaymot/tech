{% extends 'emails/_layout.html.twig' %}
{% from 'emails/_layout.html.twig' import bouton %}

{% block contenu %}
    <p>Bonjour,</p>
    <p>{{ inviter ?: 'Un administrateur' }} vous invite à rejoindre <strong>{{ collective }}</strong> en tant que {{ role|lower }}.</p>
    {{ bouton(accept_url, 'Voir l\'invitation') }}
    <p>Ce lien est valable jusqu'au {{ expires_at|date('d/m/Y', 'Europe/Paris') }} et ne sert qu'une fois.</p>
{% endblock %}

{% block note %}Si vous ne connaissez pas ce collectif, ignorez ce message.{% endblock %}
