{% extends 'emails/_layout.html.twig' %}
{% from 'emails/_layout.html.twig' import bouton %}

{% block contenu %}
    <p>Bonjour{{ display_name ? ' ' ~ display_name }},</p>
    <p>Pour vous connecter, ouvrez ce lien sur l'appareil de votre choix :</p>
    {{ bouton(login_url, 'Me connecter') }}
    <p>Il est valable jusqu'à {{ expires_at|date('H:i', 'Europe/Paris') }} et ne sert qu'une fois.</p>
{% endblock %}

{% block note %}Si vous n'avez pas demandé ce lien, ignorez ce message.{% endblock %}
