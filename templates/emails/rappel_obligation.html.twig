{% extends 'emails/_layout.html.twig' %}
{% from 'emails/_layout.html.twig' import bouton %}

{% block contenu %}
    <p>Bonjour,</p>
    <p>Pour <strong>{{ tache.soiree }}</strong> : {{ tache.libelle }}, {{ jours == 0 ? 'à faire aujourd\'hui' : 'à faire d\'ici le ' ~ tache.echeance|date('d/m/Y') }}.</p>
    {{ bouton(tache.url, 'Voir le rétroplanning') }}
{% endblock %}

{% block note %}Règle indicative, <a href="{{ tache.source }}" style="color:#6e8bff;">source</a> vérifiée le {{ tache.verifiee_le|date('d/m/Y') }}. Confirmez auprès de l'administration concernée.{% endblock %}
