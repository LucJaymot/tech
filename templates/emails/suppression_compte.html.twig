{% extends 'emails/_layout.html.twig' %}
{% from 'emails/_layout.html.twig' import bouton %}

{% block contenu %}
    <p>Bonjour,</p>
    <p>Vous ne vous êtes pas connecté à Caisson depuis longtemps. Pour protéger vos données, votre compte sera supprimé le <strong style="color:#ffb000;">{{ suppression_le|date('d/m/Y', 'Europe/Paris') }}</strong>.</p>
    <p>Pour le garder, il suffit de vous connecter avant cette date :</p>
    {{ bouton(connexion_url, 'Me connecter') }}
{% endblock %}

{% block note %}Les données des collectifs dont vous êtes membre ne sont pas supprimées avec votre compte.{% endblock %}
