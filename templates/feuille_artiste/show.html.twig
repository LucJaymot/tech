{% extends 'feuille_artiste/_layout.html.twig' %}

{% block title %}{{ feuille.artiste }} · {{ feuille.soiree }}{% endblock %}

{% block body %}
    <p class="text-sm text-slate-400">Feuille artiste · {{ feuille.artiste }}</p>
    <h1 class="text-2xl font-bold sm:text-3xl">{{ feuille.soiree }}</h1>
    <p class="mt-1 text-slate-300">
        {{ feuille.date|date('d/m/Y') }} · ouverture {{ feuille.ouverture|date('H:i') }}, fermeture {{ feuille.fermeture|date('H:i') }}
    </p>

    <div class="mt-6 flex flex-col gap-4">
        <twig:Card title="Votre passage">
            {% if feuille.passageDebut %}
                <p class="text-xl font-semibold">{{ feuille.passageDebut|date('H:i') }} – {{ feuille.passageFin|date('H:i') }}</p>
                {% if feuille.partenairesB2B is not empty %}
                    <p class="mt-1 text-slate-300">En B2B avec {{ feuille.partenairesB2B|join(', ', ' et ') }}</p>
                {% endif %}
            {% else %}
                <p class="text-slate-300">Horaire à confirmer.</p>
            {% endif %}
        </twig:Card>

        {% if feuille.lieu %}
            <twig:Card title="Lieu">
                <p class="font-medium">{{ feuille.lieu }}</p>
                <p class="mt-1 whitespace-pre-line text-slate-300">{{ feuille.adresse }}</p>
                {% if feuille.acces %}
                    <p class="mt-3 text-sm text-slate-400">Accès : {{ feuille.acces }}</p>
                {% endif %}
            </twig:Card>
        {% endif %}

        {% if feuille.timetable is not empty %}
            <twig:Card title="Programme de la soirée">
                <ul class="-my-2 divide-y divide-slate-800" id="timetable">
                    {% for passage in feuille.timetable %}
                        <li class="flex gap-4 py-2">
                            <span class="w-28 shrink-0 tabular-nums text-slate-400">{{ passage.debut|date('H:i') }} – {{ passage.fin|date('H:i') }}</span>
                            <span>{{ passage.artistes|join(' b2b ') }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </twig:Card>
        {% endif %}

        <twig:Card title="Fiche technique">
            {% set rider = feuille.rider %}
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-slate-400">Installation</dt><dd>{{ rider.installationMinutes }} min</dd>
                <dt class="text-slate-400">Balance</dt><dd>{{ rider.balanceMinutes }} min</dd>
                <dt class="text-slate-400">Fourni sur place</dt><dd>{{ rider.materielDemande is empty ? '—' : rider.materielDemande|join(', ') }}</dd>
                <dt class="text-slate-400">Vous apportez</dt><dd>{{ rider.materielApporte is empty ? '—' : rider.materielApporte|join(', ') }}</dd>
            </dl>
            {% if rider.notes %}<p class="mt-3 whitespace-pre-line text-sm text-slate-300">{{ rider.notes }}</p>{% endif %}
        </twig:Card>

        <twig:Card title="Accueil">
            {% set hospitalite = feuille.hospitalite %}
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-slate-400">Repas</dt><dd>{{ hospitalite.repas }}{% if hospitalite.regimes is not empty %} ({{ hospitalite.regimes|join(', ') }}){% endif %}</dd>
                <dt class="text-slate-400">Invitations</dt><dd>{{ hospitalite.invitations }}</dd>
                <dt class="text-slate-400">Hébergement</dt><dd>{{ hospitalite.hebergement ? 'Oui' : 'Non' }}</dd>
            </dl>
            {% if hospitalite.notes %}<p class="mt-3 whitespace-pre-line text-sm text-slate-300">{{ hospitalite.notes }}</p>{% endif %}
        </twig:Card>
    </div>
{% endblock %}
