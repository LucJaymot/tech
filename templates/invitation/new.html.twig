{% extends 'base.html.twig' %}

{% block title %}Inviter un membre{% endblock %}

{% block body %}
    {{ include('_partials/retour_soiree.html.twig', {href: path('app_collective'), nom: 'Collectif'}) }}
    <p class="etiquette">{{ collective.name }}</p>
    <h1 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">Inviter un membre</h1>
    <p class="mt-2 text-slate-400">La personne reçoit un lien par e-mail pour rejoindre le collectif en un clic. Il est valable 7 jours.</p>

    <twig:Card class="mt-6">
        {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'flex flex-col gap-5'}}) }}
            <twig:Field :field="form.email" placeholder="prenom@exemple.fr" />
            <twig:Field :field="form.role" />
            <div class="flex flex-col gap-2 sm:flex-row-reverse">
                <twig:Button type="submit" size="lg" class="sm:flex-1">Envoyer l'invitation</twig:Button>
                <twig:Button variant="ghost" size="lg" href="{{ path('app_collective') }}">Annuler</twig:Button>
            </div>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
