{# One soirée in a list: the card to its page and the shortcuts to its modules. Expects "item", "can_edit", "can_view_budget". #}
{% set soiree = item.soiree %}
{% set raccourci = 'inline-flex min-h-11 items-center rounded-[4px] border border-touche-bord bg-touche px-3 font-mono text-[0.6875rem] tracking-[0.12em] text-slate-300 uppercase shadow-[inset_0_-2px_0_#151517] transition-[color,translate] hover:text-slate-100 active:translate-y-px' %}
<li class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900 {{ item.passee ? 'opacity-70' }}">
    <a href="{{ path('app_soiree', {id: soiree.id}) }}" class="flex items-center gap-4 p-4 transition-colors hover:bg-slate-800/40">
        {# Date as a labelled tab: day and month. #}
        <span class="flex w-14 shrink-0 flex-col items-center rounded-[4px] border border-slate-700 bg-ruban py-2" aria-hidden="true">
            <span class="font-mono text-2xl leading-none font-semibold text-slate-100">{{ soiree.date|date('d') }}</span>
            <span class="etiquette mt-1 text-[0.6875rem]">{{ ['jan', 'fév', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'][soiree.date|date('n') - 1] }}</span>
        </span>
        <span class="min-w-0 flex-1">
            <span class="block truncate text-lg font-semibold tracking-[-0.01em]">{{ soiree.nom }}</span>
            <span class="sr-only">, le {{ soiree.date|date('d/m/Y') }}</span>
            <span class="mt-0.5 block truncate font-mono text-xs text-slate-400">{{ soiree.ouverture|date('H:i') }} → {{ soiree.fermeture|date('H:i') }}{{ soiree.lieu ? ' · ' ~ soiree.lieu.nom }}</span>
            <twig:Led statut="{{ {preparation: 'attention', annulee: 'bloquant'}[soiree.statut] ?? 'ok' }}" libelle="{{ soiree.statutEnum.label }}" class="mt-2" />
        </span>
        <span class="shrink-0 text-2xl leading-none tabular-nums {{ item.passee ? 'font-doto font-extrabold text-slate-500' : 'compteur' }}">{{ item.compte_a_rebours }}</span>
    </a>
    <nav aria-label="Modules de {{ soiree.nom }}" class="flex flex-wrap gap-2 border-t border-slate-800 px-4 py-3">
        <a href="{{ path('app_feuille_de_route', {id: soiree.id}) }}" class="{{ raccourci }}">Feuille de route</a>
        <a href="{{ path('app_planning', {id: soiree.id}) }}" class="{{ raccourci }}">Planning</a>
        <a href="{{ path('app_retroplanning', {id: soiree.id}) }}" class="{{ raccourci }}">Démarches</a>
        {% if can_edit %}
            <a href="{{ path('app_guest_lists', {id: soiree.id}) }}" class="{{ raccourci }}">Invités</a>
            <a href="{{ path('app_pointage', {id: soiree.id}) }}" class="{{ raccourci }}">Pointage</a>
            <a href="{{ path('app_visuels', {id: soiree.id}) }}" class="{{ raccourci }}">Visuels</a>
        {% endif %}
        {% if can_view_budget %}
            <a href="{{ path('app_budget', {id: soiree.id}) }}" class="{{ raccourci }}">Budget</a>
            <a href="{{ path('app_bilan', {id: soiree.id}) }}" class="{{ raccourci }}">Bilan</a>
        {% endif %}
    </nav>
</li>
