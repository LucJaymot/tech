{% extends 'base.html.twig' %}

{% block title %}{{ soiree.nom }}{% endblock %}

{% block body %}
    {{ include('_partials/retour_soiree.html.twig', {href: path('app_soirees'), nom: 'Soirées'}) }}
    <header class="flex items-start justify-between gap-4" id="en-tete">
        <div class="min-w-0">
            <p class="etiquette">Soirée · {{ soiree.date|date('d/m/Y') }}</p>
            <h1 class="text-2xl font-bold tracking-[-0.02em] sm:text-3xl">{{ soiree.nom }}</h1>
            <p class="mt-1 text-slate-300">
                {{ horaires.ouverture|date('H:i') }} → {{ horaires.fermeture|date('H:i') }}{% if horaires.fermeture|date('Y-m-d') != horaires.ouverture|date('Y-m-d') %} (lendemain){% endif %}
                {% if soiree.lieu %} · {{ soiree.lieu.nom }}{% endif %}
            </p>
            <p class="mt-2" id="statut">
                <twig:Led statut="{{ {preparation: 'attention', annulee: 'bloquant'}[soiree.statut] ?? 'ok' }}" libelle="{{ soiree.statutEnum.label }}" />
            </p>
        </div>
        <div class="flex shrink-0 flex-col items-end gap-3">
            <p class="compteur text-4xl leading-none tabular-nums sm:text-5xl" id="compte-a-rebours" aria-label="{{ compte_a_rebours == 'Jour J' ? 'C\'est aujourd\'hui' : compte_a_rebours }}">{{ compte_a_rebours }}</p>
            {% if peut_modifier %}
                <twig:Button href="{{ path('app_soiree_modifier', {id: soiree.id}) }}" variant="secondary" size="sm" id="modifier">Modifier</twig:Button>
            {% endif %}
        </div>
    </header>

    {# In the order of the soirée's life: prepare, the night, afterwards. #}
    <section class="mt-8 flex flex-col gap-4" aria-labelledby="phase-preparer">
        <h2 class="etiquette" id="phase-preparer">Préparer</h2>
        <twig:Card title="Démarches" niveau="3" id="module-taches">
            {% if taches.ouvertes == 0 %}
                <twig:Led statut="ok" libelle="Aucune démarche ouverte" />
            {% else %}
                <twig:Led statut="{{ taches.statut }}" libelle="{{ taches.ouvertes }} démarche{{ taches.ouvertes > 1 ? 's' }} à faire{{ taches.en_retard ? ', dont ' ~ taches.en_retard ~ ' en retard' }}" />
                <p class="mt-2 text-sm text-slate-300">Prochaine : {{ taches.prochaine.libelle }}, avant le {{ taches.prochaine.echeance|date('d/m/Y') }}</p>
            {% endif %}
            <twig:block name="footer">
                <twig:Button href="{{ path('app_retroplanning', {id: soiree.id}) }}" variant="secondary" size="sm">Démarches</twig:Button>
            </twig:block>
        </twig:Card>

        <twig:Card title="Line-up" niveau="3" id="module-line-up">
            <ul class="-my-2 divide-y divide-slate-800 text-sm">
                {% for passage in line_up %}
                    <li class="flex gap-4 py-2">
                        <span class="w-28 shrink-0 font-mono tabular-nums text-slate-400">{{ passage.debut|date('H:i') }} – {{ passage.fin|date('H:i') }}</span>
                        <span>{{ passage.artistes is empty ? 'À programmer' : passage.artistes|join(' b2b ') }}</span>
                    </li>
                {% else %}
                    <li class="py-2 text-slate-500">Aucun passage programmé.</li>
                {% endfor %}
            </ul>
            <twig:block name="footer">
                <twig:Button href="{{ path('app_line_up', {id: soiree.id}) }}" variant="secondary" size="sm" id="lien-line-up">Line-up</twig:Button>
                {% if peut_modifier %}<twig:Button href="{{ path('app_visuels', {id: soiree.id}) }}" variant="secondary" size="sm">Visuels</twig:Button>{% endif %}
                <twig:Button href="{{ path('app_soiree_publique', {slug: soiree.slug}) }}" variant="secondary" size="sm" id="page-publique">Page publique</twig:Button>
            </twig:block>
        </twig:Card>

        <twig:Card title="Bénévoles" niveau="3" id="module-benevoles">
            {% if benevoles.creneaux == 0 %}
                <p class="text-sm text-slate-500">Aucun créneau pour l'instant.</p>
            {% elseif benevoles.manquants == 0 %}
                <twig:Led statut="ok" libelle="{{ benevoles.creneaux }} créneau{{ benevoles.creneaux > 1 ? 'x' }}, tous pourvus" />
            {% else %}
                <twig:Led statut="bloquant" libelle="{{ benevoles.manquants }} personne{{ benevoles.manquants > 1 ? 's' }} manquante{{ benevoles.manquants > 1 ? 's' }} sur {{ benevoles.creneaux }} créneau{{ benevoles.creneaux > 1 ? 'x' }}" />
            {% endif %}
            <twig:block name="footer">
                <twig:Button href="{{ path('app_planning', {id: soiree.id}) }}" variant="secondary" size="sm">Planning</twig:Button>
            </twig:block>
        </twig:Card>

        <twig:Card title="Guest-lists" niveau="3" id="module-guest-lists">
            <p class="text-sm text-slate-300">
                {{ guest_lists.personnes }} personne{{ guest_lists.personnes > 1 ? 's' }} sur {{ guest_lists.listes }} liste{{ guest_lists.listes > 1 ? 's' }}{% if guest_lists.arrives %} · {{ guest_lists.arrives }} arrivée{{ guest_lists.arrives > 1 ? 's' }}{% endif %}
            </p>
            <twig:block name="footer">
                {% if peut_modifier %}
                    <twig:Button href="{{ path('app_guest_lists', {id: soiree.id}) }}" variant="secondary" size="sm">Invités</twig:Button>
                {% endif %}
            </twig:block>
        </twig:Card>
{% if budget %}

            <twig:Card title="Budget" niveau="3" id="module-budget">
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                    <dt class="text-slate-400">Solde prévu</dt><dd class="text-right font-mono tabular-nums">{{ budget.soldePrevu|euros }}</dd>
                    <dt class="text-slate-400">Solde réel</dt><dd class="text-right font-mono tabular-nums">{{ budget.soldeReel|euros }}</dd>
                </dl>
                {% if budget.lignesSansReel > 0 %}
                    <p class="mt-2"><twig:Led statut="attention" libelle="{{ budget.lignesSansReel }} montant{{ budget.lignesSansReel > 1 ? 's' }} réel{{ budget.lignesSansReel > 1 ? 's' }} inconnu{{ budget.lignesSansReel > 1 ? 's' }}" /></p>
                {% endif %}
                <twig:block name="footer">
                    <twig:Button href="{{ path('app_budget', {id: soiree.id}) }}" variant="secondary" size="sm">Budget</twig:Button>
                </twig:block>
            </twig:Card>
{% endif %}
    </section>

    <section class="mt-10 flex flex-col gap-4" aria-labelledby="phase-soir">
        <h2 class="etiquette" id="phase-soir">Le soir J</h2>
        <div class="grid gap-3 sm:grid-cols-2" id="module-soir-j">
            <a href="{{ path('app_feuille_de_route', {id: soiree.id}) }}" class="flex min-h-24 flex-col justify-between gap-3 rounded-lg border border-touche-bord bg-touche p-4 shadow-[inset_0_-3px_0_#151517] transition-[translate] active:translate-y-px">
                <span class="font-mono text-xs tracking-[0.14em] text-slate-100 uppercase">Feuille de route</span>
                <span class="text-sm text-slate-300">Horaires, équipe, contacts et checks, même hors ligne.</span>
            </a>
            {% if peut_modifier %}
                <a href="{{ path('app_pointage', {id: soiree.id}) }}" class="flex min-h-24 flex-col justify-between gap-3 rounded-lg border border-touche-bord bg-touche p-4 shadow-[inset_0_-3px_0_#151517] transition-[translate] active:translate-y-px">
                    <span class="font-mono text-xs tracking-[0.14em] text-slate-100 uppercase">Pointage</span>
                    <span class="text-sm text-slate-300">Les invités à l'entrée, au fil de la nuit.</span>
                </a>
            {% endif %}
        </div>
    </section>
{% if budget %}

    <section class="mt-10 flex flex-col gap-4" aria-labelledby="phase-apres">
        <h2 class="etiquette" id="phase-apres">Après</h2>
        <a href="{{ path('app_bilan', {id: soiree.id}) }}" class="flex min-h-24 flex-col justify-between gap-3 rounded-lg border border-touche-bord bg-touche p-4 shadow-[inset_0_-3px_0_#151517] transition-[translate] active:translate-y-px" id="module-apres">
            <span class="font-mono text-xs tracking-[0.14em] text-slate-100 uppercase">Bilan</span>
            <span class="text-sm text-slate-300">Réel contre prévu, débriefing de l'équipe, clôture.</span>
        </a>
    </section>
{% endif %}

{% if peut_annuler %}
    <form method="post" action="{{ path('app_soiree_annuler', {id: soiree.id}) }}" class="mt-10" id="annuler">
        <input type="hidden" name="_token" value="{{ csrf_token('annuler-soiree') }}">
        <p class="mb-3 text-sm text-slate-400">Les démarches de la soirée ne seront plus rappelées. Cette action est définitive.</p>
        <twig:Button type="submit" variant="danger" size="sm">Annuler la soirée</twig:Button>
    </form>
{% endif %}
{% endblock %}
