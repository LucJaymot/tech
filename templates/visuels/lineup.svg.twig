<?xml version="1.0" encoding="UTF-8"?>
{#
    Line-up visual, rendered server-side by App\Visuel\VisuelsLineUp.
    SVG has no text wrapping: font sizes shrink with the text length,
    estimated at 0.58 em per character.
#}
{% set marge = 80 %}
{% set utile = largeur - 2 * marge %}
{% set y_titre = hauteur > largeur ? 560 : 360 %}
{% set taille_titre = min(110, utile / (max(soiree|length, 1) * 0.58)) %}
{% set haut_zone = y_titre + 200 %}
{% set bas_zone = hauteur - 180 %}
{% set nb = max(artistes|length, 1) %}
{% set taille_base = min(hauteur > largeur ? 96 : 72, (bas_zone - haut_zone) / (nb * 1.3)) %}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ largeur }}" height="{{ hauteur }}" viewBox="0 0 {{ largeur }} {{ hauteur }}" font-family="Helvetica, Arial, sans-serif">
    <rect width="100%" height="100%" fill="#0b0b10"/>
    <rect x="0" y="0" width="24" height="{{ hauteur }}" fill="{{ accent }}"/>

    {% if logo %}
        <image href="{{ logo }}" x="{{ marge }}" y="{{ marge }}" width="160" height="160" preserveAspectRatio="xMinYMin meet"/>
    {% else %}
        <text x="{{ marge }}" y="{{ marge + 40 }}" font-size="40" font-weight="700" fill="{{ accent_lisible }}">{{ collectif }}</text>
    {% endif %}

    <text x="{{ marge }}" y="{{ y_titre }}" font-size="{{ taille_titre|round(1) }}" font-weight="800" fill="#ffffff">{{ soiree }}</text>
    <text x="{{ marge }}" y="{{ y_titre + 80 }}" font-size="40" fill="{{ accent_lisible }}">{{ jour|capitalize }} · {{ ouverture }}{{ lieu ? ' · ' ~ lieu }}</text>

    {% for artiste in artistes %}
        {% set taille = min(taille_base, utile / (max(artiste|length, 1) * 0.58)) %}
        <text x="{{ marge }}" y="{{ haut_zone + (loop.index0 + 1) * taille_base * 1.3 }}" font-size="{{ taille|round(1) }}" font-weight="700" fill="#ffffff">{{ artiste }}</text>
    {% else %}
        <text x="{{ marge }}" y="{{ haut_zone + taille_base }}" font-size="{{ taille_base|round(1) }}" font-weight="700" fill="#ffffff">Line-up à venir</text>
    {% endfor %}

    {# Caisson stamp: discreet, bottom right. #}
    <g opacity="0.4" transform="translate({{ largeur - marge }} {{ hauteur - marge }})">
        <rect x="-190" y="-44" width="190" height="56" rx="12" fill="none" stroke="#ffffff" stroke-width="2"/>
        <text x="-95" y="-7" font-size="24" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">CAISSON</text>
    </g>
</svg>
